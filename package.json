{
  "name": "synth-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "NODE_OPTIONS='--max-old-space-size=3072' next dev",
    "start": "serve out",
    "deploy": "pnpm run build && wrangler deploy",
    "upload": "pnpm run build && wrangler versions upload",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "clean": "rm -rf .next .source out",
    "lint": "biome check",
    "format": "biome format --write",
    "lint:fix": "biome check --write",
    "publish-image": "node scripts/publish-image.mjs"
  },
  "dependencies": {
    "@takumi-rs/image-response": "2.19.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-transition": "^3.0.2",
    "fumadocs-core": "16.18.0",
    "fumadocs-mdx": "15.5.0",
    "fumadocs-ui": "16.18.0",
    "mermaid": "12.3.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@tailwindcss/postcss": "4.3.4",
    "@types/d3-transition": "^3.0.9",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "serve": "14.2.6",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "wrangler": "4.158.0"
  },
  "packageManager": "pnpm@10.12.1"
}
